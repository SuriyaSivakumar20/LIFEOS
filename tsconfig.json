{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@lifeos/core": ["./packages/core/src"],
      "@lifeos/core/*": ["./packages/core/src/*"],
      "@lifeos/database": ["./packages/database/src"],
      "@lifeos/database/*": ["./packages/database/src/*"],
      "@lifeos/shared-types": ["./packages/shared-types/src"],
      "@lifeos/shared-types/*": ["./packages/shared-types/src/*"],
      "@lifeos/ui": ["./packages/ui/src"],
      "@lifeos/ui/*": ["./packages/ui/src/*"],
      "@lifeos/alfred": ["./packages/alfred/src"],
      "@lifeos/alfred/*": ["./packages/alfred/src/*"],
      "@lifeos/voice": ["./packages/voice/src"],
      "@lifeos/voice/*": ["./packages/voice/src/*"],
      "@lifeos/notifications": ["./packages/notifications/src"],
      "@lifeos/notifications/*": ["./packages/notifications/src/*"]
    }
  },
  "include": [
    "packages/*/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "apps"
  ]
}
